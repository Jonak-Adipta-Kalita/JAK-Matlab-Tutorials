clc, clear;

syms x y

f = 3*y^2 - 2*y^3 - 3*x^2 + 6*x*y;

fx = diff(f, x, 1);
fy = diff(f, y, 1);
fxx = diff(fx, x, 1);
fyy = diff(fy, y, 1);
fxy = diff(fx, y, 1);

critEquations = [fx fy];
[xCrits, yCrits] = solve(crit_equations, [x y]);

crits = [xCrits(:), yCrits(:)];

hessian = [fxx fxy ; fxy fyy];

delta = det(hessian)