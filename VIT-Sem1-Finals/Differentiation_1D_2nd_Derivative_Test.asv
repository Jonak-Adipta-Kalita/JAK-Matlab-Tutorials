clc, clear, close all;

syms x;

f = 1/7*x^7 - (14/5)*x^5 + (49/3)*x^3 - 36*x;

f_1d = diff(f, x);
f_2d = diff(f_1d, x);
crits = solve(f_1d);
fprintf("There are %d Critical Points\n\n", length(crits));

fplot(f)
hold on;

for i = 1:length(crits)
    a = subs(f_2d, x, crits(i));
    val = subs(f, x, crits(i));

    if a > 0
        fprintf("At x=%.2f, Function has a Minimum of %.2f\n", crits(i), val)
        plot(crits(i), val, "y^")
    elseif a < 0
        fprintf("At x=%.2f, Function has a Maximum of %.2f\n", crits(i), val)
        plot(crits(i), val, "rs")
    elseif a == 0
        fprintf("At x=%.2f, Function has a Point of Inflection of %.2f", crits(i), val)
        plot(crits(i), val, "go")
    end
end
    